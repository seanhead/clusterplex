#!/usr/bin/with-contenv bash

echo "**** Setting up codecs directory ****"
if [ -d "/codecs" ]
then
    echo "Directory already present"
else
    echo "Creating /codecs"
    mkdir -p /codecs
fi

echo "**** Changing ownership for /codecs ****"
chown abc:abc /codecs

echo "**** Setting up /run/clusterplex for container-local EAE PID ****"
mkdir -p /run/clusterplex
# Runs before the PUID/PGID remap of abc, so use the numeric IDs
chown "${PUID:-911}:${PGID:-911}" /run/clusterplex
